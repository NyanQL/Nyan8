{
  "connections": {
    "inventory-read": {
      "credentialMode": "service",
      "allowedScripts": [
        "/opt/nyan/Nyan8/javascript/mcp_lookup.js"
      ],
      "tools": {
        "lookup_stock": {
          "readOnly": true
        }
      },
